{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "sh",
          "cmd": "sh",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ping",
          "cmd": "ping",
          "args": true,
          "sidecar": false
        },
        {
          "name": "adb",
          "cmd": "adb",
          "args": true,
          "sidecar": false
        },
        {
          "name": "iperf3",
          "cmd": "iperf3",
          "args": true,
          "sidecar": false
        },
        {
          "name": "aria2c",
          "cmd": "aria2c",
          "args": true,
          "sidecar": false
        },
        {
          "name": "curl",
          "cmd": "curl",
          "args": true,
          "sidecar": false
        },
        {
          "name": "pkill",
          "cmd": "pkill",
          "args": true,
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "sh",
          "cmd": "sh",
          "args": true,
          "sidecar": false
        },
        {
          "name": "adb",
          "cmd": "adb",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ping",
          "cmd": "ping",
          "args": true,
          "sidecar": false
        },
        {
          "name": "iperf3",
          "cmd": "iperf3",
          "args": true,
          "sidecar": false
        },
        {
          "name": "aria2c",
          "cmd": "aria2c",
          "args": true,
          "sidecar": false
        },
        {
          "name": "curl",
          "cmd": "curl",
          "args": true,
          "sidecar": false
        },
        {
          "name": "pkill",
          "cmd": "pkill",
          "args": true,
          "sidecar": false
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "fs:default",
    "dialog:default",
    "process:default"
  ]
}