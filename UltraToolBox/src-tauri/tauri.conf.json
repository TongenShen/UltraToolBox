{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UltraToolBox",
  "version": "0.1.0",
  "identifier": "com.shentongen.ultratoolbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UltraToolBox",
        "label": "main",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "scope": [
        { "name": "sh", "cmd": "sh", "args": true },
        { "name": "open", "cmd": "open", "args": true },
        { "name": "ping", "cmd": "ping", "args": true },
        { "name": "adb", "cmd": "adb", "args": true },
        { "name": "iperf3", "cmd": "iperf3", "args": true },
        { "name": "aria2c", "cmd": "aria2c", "args": true },
        { "name": "curl", "cmd": "curl", "args": true },
        { "name": "pkill", "cmd": "pkill", "args": true }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": []
  }
}
